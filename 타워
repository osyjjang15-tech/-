-- 폭발 이펙트
local function CreateExplosionEffect(position)
   local explosion = Instance.new("Explosion")
   explosion.Position = position
   explosion.BlastRadius = 8
   explosion.BlastPressure = 0 -- 물리 영향 없이 시각만
   explosion.Visible = true
   explosion.Parent = workspace
   Debris:AddItem(explosion, 3)
end

-- 파티클 폭발
local function CreateParticleBurst(position)
   local part = Instance.new("Part")
   part.Size = Vector3.new(0.5, 0.5, 0.5)
   part.Position = position
   part.Anchored = true
   part.CanCollide = false
   part.Transparency = 1
   part.Parent = workspace

   local emitter = Instance.new("ParticleEmitter")
   emitter.Texture = "rbxassetid://241650934" -- 기본 스파크
   emitter.Color = ColorSequence.new({
      ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 50, 50)),
      ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 0))
   })
   emitter.Size = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 1.5),
      NumberSequenceKeypoint.new(1, 0)
   })
   emitter.Lifetime = NumberRange.new(0.8, 1.4)
   emitter.Speed = NumberRange.new(15, 35)
   emitter.SpreadAngle = Vector2.new(180, 180)
   emitter.Rate = 0
   emitter.Parent = part

   emitter:Emit(40)
   Debris:AddItem(part, 2)
end

-- KILL 텍스트 이펙트
local function CreateKillText(position, playerName)
   local billboard = Instance.new("BillboardGui")
   billboard.Size = UDim2.new(0, 150, 0, 50)
   billboard.StudsOffset = Vector3.new(0, 4, 0)
   billboard.AlwaysOnTop = true
   billboard.Parent = workspace

   local part = Instance.new("Part")
   part.Size = Vector3.new(1, 1, 1)
   part.Position = position
   part.Anchored = true
   part.CanCollide = false
   part.Transparency = 1
   part.Parent = workspace
   billboard.Adornee = part

   local label = Instance.new("TextLabel")
   label.Size = UDim2.new(1, 0, 1, 0)
   label.BackgroundTransparency = 1
   label.Text = "KILL"
   label.TextColor3 = Color3.fromRGB(255, 30, 30)
   label.TextStrokeTransparency = 0.3
   label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
   label.Font = Enum.Font.GothamBlack
   label.TextSize = 28
   label.Parent = billboard

   -- 위로 떠오르면서 사라지는 트윈
   local tween = TweenService:Create(billboard, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
      StudsOffset = Vector3.new(0, 8, 0)
   })
   tween:Play()

   local fade = TweenService:Create(label, TweenInfo.new(1.2), {
      TextTransparency = 1,
      TextStrokeTransparency = 1
   })
   fade:Play()

   Debris:AddItem(part, 1.5)
   Debris:AddItem(billboard, 1.5)
end

-- 히트 시 빨간 하이라이트
local function CreateHitHighlight(character)
   if not character then return end
   local highlight = Instance.new("Highlight")
   highlight.FillColor = Color3.fromRGB(255, 0, 0)
   highlight.OutlineColor = Color3.fromRGB(255, 80, 80)
   highlight.FillTransparency = 0.3
   highlight.OutlineTransparency = 0
   highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
   highlight.Parent = character

   Debris:AddItem(highlight, 0.6)
end

-- Kill Aura 범위 표시 (발 밑에 원)
local RangePart = nil
local function UpdateKillAuraRangeVisual()
   if RangePart then RangePart:Destroy() RangePart = nil end
   if not KillAuraEnabled then return end

   local hrp = GetHRP()
   if not hrp then return end

   RangePart = Instance.new("Part")
   RangePart.Name = "KillAuraRange"
   RangePart.Anchored = true
   RangePart.CanCollide = false
   RangePart.Size = Vector3.new(KillAuraRange * 2, 0.2, KillAuraRange * 2)
   RangePart.Material = Enum.Material.Neon
   RangePart.Color = Color3.fromRGB(255, 40, 40)
   RangePart.Transparency = 0.7
   RangePart.Shape = Enum.PartType.Cylinder
   RangePart.CFrame = hrp.CFrame * CFrame.Angles(0, 0, math.rad(90))
   RangePart.Parent = workspace

   -- 따라다니기
   local conn
   conn = RunService.RenderStepped:Connect(function()
      if not KillAuraEnabled or not RangePart or not GetHRP() then
         if RangePart then RangePart:Destroy() end
         conn:Disconnect()
         return
      end
      RangePart.Size = Vector3.new(KillAuraRange * 2, 0.2, KillAuraRange * 2)
      RangePart.CFrame = GetHRP().CFrame * CFrame.Angles(0, 0, math.rad(90))
   end)
end

-- ====================== 킬 함수 (이펙트 포함) ======================
local function KillPlayer(targetPlayer)
   if not targetPlayer or targetPlayer == LocalPlayer then return false end
   local char = targetPlayer.Character
   if not char then return false end
   local hum = char:FindFirstChildOfClass("Humanoid")
   local hrp = char:FindFirstChild("HumanoidRootPart")
   if not hum or hum.Health <= 0 or not hrp then return false end

   -- 이펙트 먼저 재생
   CreateExplosionEffect(hrp.Position)
   CreateParticleBurst(hrp.Position)
   CreateKillText(hrp.Position, targetPlayer.Name)
   CreateHitHighlight(char)

   -- 실제 킬 시도
   pcall(function() hum.Health = 0 end)
   pcall(function() hum:TakeDamage(math.huge) end)
   pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)

   return true
end

